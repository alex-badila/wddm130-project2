<%- include("layouts/header"); -%>
<%- include("layouts/nav"); -%>

<h2>Results / Confirmation</h2>
<!-- Display the results from the form -->
<section>
    <% if(typeof(results) !== "undefined"){%>
      <p>Full Name: <%= results.fullName %></p>
      <p>Student ID: <%= results.studentID %></p>
      <p>Email Address: <%= results.emailAddress %></p>
      <p>Program Name: <%= results.programName %></p>
      <p>Service Type: <%= results.serviceType %></p>
      <p>Urgency Level: <%= results.urgencyLevel %></p>
      <p>Request Description: <%= results.requestDescription %></p>
      <p>Preferred Contact Method: <%= results.preferredContactMethod %></p>
      <p>Response Time: <%= results.responseTime %></p>
      <p>Fee: $<%= results.fee %></p>
      <p>Student Card Image:</p>
      <img src="/<%= results.studentCardImagePath %>"/>
    <%}%>
</section>
<%- include("layouts/footer"); -%>